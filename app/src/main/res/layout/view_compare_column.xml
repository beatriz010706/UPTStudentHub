<?xml version="1.0" encoding="utf-8"?>
<!-- Uma coluna da comparação (um local) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/spacing_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_s">

        <TextView
            android:id="@+id/tvColPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <ProgressBar
            android:id="@+id/progressCol"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:contentDescription="@string/cd_weather_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvColMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivColIcon"
            android:layout_width="@dimen/ex_icon_column"
            android:layout_height="@dimen/ex_icon_column"
            android:layout_marginTop="@dimen/spacing_s"
            android:contentDescription="@string/cd_weather_icon"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvColMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvColMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvColRain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
